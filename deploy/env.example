# Copy to /etc/fairteiler/env (VPS) or set in the Render dashboard (free tier).
# Never commit real values.

# SQLite (VPS):   sqlite:////var/lib/fairteiler/fairteiler.db
# Postgres/Neon:  postgresql+psycopg://user:pass@host/db?sslmode=require
FAIRTEILER_DB=

# Salt for hashing device ids (any long random string)
DEVICE_SALT=

# Only needed for cross-origin hosting (GitHub Pages variant)
#CORS_ORIGINS=https://<user>.github.io

# From scripts/generate_vapid.py — enables push when set
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:[KONTAKT-E-MAIL]

# Optional Telegram bridge (only with group-admin consent)
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
#FAIRTEILER_APP_URL=https://deastiny.uber.space
